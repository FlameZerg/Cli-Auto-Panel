{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CLI Auto Panel",
  "version": "0.1.0",
  "identifier": "local.cliautopanel.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev:renderer",
    "beforeBuildCommand": "npm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CLI 通用配置面板",
        "width": 1440,
        "height": 940,
        "minWidth": 1050,
        "minHeight": 700,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
